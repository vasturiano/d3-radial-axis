{
  "name": "d3-radial-axis",
  "version": "1.8.2",
  "description": "Radial axes for D3 components.",
  "license": "MIT",
  "keywords": [
    "d3",
    "d3-module",
    "axis",
    "radial",
    "polar",
    "spiral",
    "scale",
    "visualization"
  ],
  "type": "module",
  "jsdelivr": "dist/d3-radial-axis.min.js",
  "unpkg": "dist/d3-radial-axis.min.js",
  "main": "dist/d3-radial-axis.mjs",
  "module": "dist/d3-radial-axis.mjs",
  "exports": {
    "umd": "./dist/d3-radial-axis.js",
    "default": "./dist/d3-radial-axis.mjs"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasturiano/d3-radial-axis.git"
  },
  "author": {
    "name": "Vasco Asturiano",
    "url": "https://github.com/vasturiano"
  },
  "homepage": "https://github.com/vasturiano/d3-radial-axis#readme",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c",
    "dev": "rollup -c -w",
    "prepare": "npm run build"
  },
  "dependencies": {
    "d3-scale": "1 - 4",
    "d3-shape": "1 - 3"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "rimraf": "^6.1.4",
    "rollup": "^4.67.5"
  },
  "engines": {
    "node": ">=12"
  }
}
